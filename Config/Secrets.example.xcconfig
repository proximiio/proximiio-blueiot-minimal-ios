// Template. Copy to Config/Secrets.xcconfig and fill in. The copy is gitignored
// (see .gitignore) and is the only place for real values. Config/App.xcconfig is
// tracked, leaves the credential keys empty and `#include?`s the copy last, so
// the values set here win.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// NOTE: "//" starts a comment in xcconfig. Write URLs as https:/$()/host, without quotes.

// Proximi.io application token: Proximi.io Portal → organisation → Application
// token. It is a per-customer JWT. Do not commit it or paste it into an issue.
PROXIMIIO_APPLICATION_TOKEN =

// The relay-api install the app binds wristbands with.
//   Sandbox, for development and testing:   https:/$()/relay-api-sandbox.proximi.fi
//   Production: the venue's own relay-api URL, from your Proximi.io contact.
// Config/App.xcconfig sets the sandbox as the default.
BLUEIOT_RELAY_URL = https:/$()/relay-api-sandbox.proximi.fi

// The relay-api app token of that install, sent as `Authorization: Bearer` on a
// wristband bind. Each install has its own token; obtain it from your Proximi.io
// contact. Without a valid token every bind fails with "app token rejected".
BLUEIOT_RELAY_APP_TOKEN =
