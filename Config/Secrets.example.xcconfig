// Template. Copy to Config/Secrets.xcconfig and fill in. The copy is gitignored
// (see .gitignore) and is the only place for real values. Config/App.xcconfig is
// tracked, leaves the keys empty and `#include?`s the copy last, so the values
// set here win.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Only credentials belong here. Venue settings such as the engine's ground floor
// number are not secret and are set in the tracked Config/App.xcconfig.
//
// NOTE: "//" starts a comment in xcconfig. Write URLs as https:/$()/host, without quotes.

// Proximi.io application token: Proximi.io Portal → organisation → Application
// token. It is a per-customer JWT. Do not commit it or paste it into an issue.
PROXIMIIO_APPLICATION_TOKEN =

// The Proximi.io cloud relay the app receives wristband positions from. This
// key and BLUEIOT_CLOUD_RELAY_TOKEN select the relay; the app attaches one.
//   Production, for the venue:              blueiot.proximi.fi
//   Sandbox, for development and testing:   relay-sandbox.proximi.fi
// A bare host is enough; the SDK derives https://… and wss://…/stream from it.
BLUEIOT_CLOUD_RELAY_URL = blueiot.proximi.fi

// The stream token of the relay above, sent as `Authorization: Bearer`. Each
// relay has its own token; obtain it from your Proximi.io contact. Without a
// matching token the relay answers HTTP 401 and no position arrives.
BLUEIOT_CLOUD_RELAY_TOKEN =
