// TEMPLATE — copy to Config/Secrets.xcconfig and fill in. That copy is gitignored
// (see .gitignore) and is the ONLY place a real value may live. Config/App.xcconfig
// is tracked and stays empty; it `#include?`s your copy last, so what you set here wins.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// NOTE: "//" starts a comment in xcconfig — write URLs as https:/$()/host, no quotes.

// Proximi.io application token. Dashboard → your organisation → Application token.
// It is a JWT and it is per-customer: never commit it, never paste it into an issue.
PROXIMIIO_APPLICATION_TOKEN =

// The Proximi.io cloud relay that carries the venue's wristband positions.
// A bare host is enough (it becomes https://…); the SDK derives wss://…/stream from it.
BLUEIOT_CLOUD_RELAY_URL = blueiot.proximi.fi

// That relay's stream token, sent as `Authorization: Bearer`. Ask your Proximi.io
// contact. Without it the relay answers HTTP 401 and no position ever arrives.
BLUEIOT_CLOUD_RELAY_TOKEN =
