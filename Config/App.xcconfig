// Base build configuration. Tracked; no credential belongs in this file.
//
// The three credential keys are empty here and take their values from the
// untracked Config/Secrets.xcconfig, which the `#include?` at the end pulls in
// last (the last assignment wins). Empty values leave the Info.plist keys empty;
// the app then shows a setup hint instead of crashing.
//
// Copy Config/Secrets.example.xcconfig to Config/Secrets.xcconfig and fill it in
// there. That file is gitignored.
//
// NOTE: "//" starts a comment in xcconfig. Write URLs as https:/$()/host, without quotes.
PROXIMIIO_APPLICATION_TOKEN =
BLUEIOT_CLOUD_RELAY_URL =
BLUEIOT_CLOUD_RELAY_TOKEN =

// The value below is a venue setting, not a credential, so it is tracked here.

// The floor number the venue's BlueIoT LocalSense engine reports for the ground
// floor. A LocalSense engine numbers floors from 1 with no 0 and basements
// negative; Proximi.io numbers the ground floor 0. `1` states that convention;
// the SDK applies the shift above ground only (engine 1 is level 0, engine 2 is
// level 1, engine -1 stays level -1). Empty = 0: no shift, for an engine that
// numbers the ground floor 0.
BLUEIOT_GROUND_FLOOR_NO = 1
#include? "Secrets.xcconfig"
