<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BlueiotRelayAppToken</key>
	<string>$(BLUEIOT_RELAY_APP_TOKEN)</string>
	<key>BlueiotRelayURL</key>
	<string>$(BLUEIOT_RELAY_URL)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Venue Map</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth is used by indoor positioning.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera helps resolve the direction of nearby ultra-wideband anchors. This app does not use it.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Confirms that you are in the venue when you connect a wristband. This app asks for location only while you use it.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>WristbandTakeover</key>
		<string>Your precise location confirms that you are in the venue before this phone follows the wristband.</string>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Confirms that you are in the venue when you connect a wristband, and keeps your position updating while the app is in your pocket or the screen is locked. Your position on the map comes from the venue's anchors, not from this phone.</string>
	<key>NSMotionUsageDescription</key>
	<string>Motion data smooths the position between updates.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Ultra-wideband ranging improves indoor positioning accuracy.</string>
	<key>ProximiioApplicationToken</key>
	<string>$(PROXIMIIO_APPLICATION_TOKEN)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
